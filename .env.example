# ==============================================================================
# RentPilot — Environment Configuration
# ==============================================================================
# Note: Never commit real credentials or .env.local to version control.
# Copy this file to .env.local and populate with your project credentials.

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public / Browser-safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_app_id:web:your_web_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK Configuration (Server-side ONLY — Never expose to client)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Format: Replace escaped newlines \n with actual newlines or keep single-line \n
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Supabase Configuration (Third-Party Auth & PostgreSQL / Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server-only: used for backend administration / service migrations where required
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 4. Brevo Email API (Server-side ONLY)
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@rentpilot.app
BREVO_SENDER_NAME="RentPilot Notifications"

# ------------------------------------------------------------------------------
# 5. Application URL & Security (Stage F Reliability & Heartbeat)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
CRON_SECRET=your_secure_cron_secret_here
